# Backend: use valores largos y distintos; no confirme este archivo con secretos reales.
HG_DB_PATH=data/heatguard.sqlite
HG_ADMIN_API_KEY=REEMPLAZAR_ADMIN
HG_VIEWER_API_KEY=REEMPLAZAR_VISOR
HG_ENABLE_DEMO=0
HG_ALLOWED_ORIGINS=http://127.0.0.1:8000

# Pasarela BLE
HG_GATEWAY_API_URL=http://127.0.0.1:8000/v1/live/ingest
HG_GATEWAY_EVENTS_API_URL=http://127.0.0.1:8000/v1/fleet/device-events
HG_GATEWAY_API_KEY=REEMPLAZAR_GATEWAY
HG_GATEWAY_OUTBOX_PATH=data/heatguard_gateway_outbox.sqlite

# Opcional; no despliegue pesos exploratorios incluidos en results/.
# HG_ML_MODEL_PATH=C:/ruta/modelo-confiable.joblib
# HG_ML_MODEL_SHA256=SHA256_ESPERADO
